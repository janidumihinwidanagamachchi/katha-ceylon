# Copy this file to `.env` and fill in your own values. `.env` is gitignored.

# Base URL of the legacy backend. Used two ways: the dev server proxies /api to
# it, and `src/lib/api.js` falls back to it if a dish or region slug is missing
# from the local catalogue in `src/content/`.
VITE_FALLBACK_API_URL=https://katha-stories-2.emergent.host

# Public origin of the deployed site. Used for the QR codes and og:url. Falls
# back to window.location.origin when empty, which is correct for local dev.
VITE_SITE_URL=

# Supabase project URL. Only read by `vite.config.js` for the dev proxy; leave
# empty to run entirely against the local catalogue.
VITE_SUPABASE_URL=